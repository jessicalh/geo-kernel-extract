Cell[TextData[{
 StyleBox["Pople, J. A.",
  FontWeight->Bold],
 " (1956). Proton magnetic resonance of hydrocarbons. ",
 StyleBox["Journal of Chemical Physics",
  FontSlant->Italic],
 " ",
 StyleBox["24",
  FontWeight->Bold],
 ", 1111. The point-dipole model of the aromatic ring current."
}], "Item",ExpressionUUID->"e6864052-53f6-6e4e-9cb7-12d39718cc96"],

Cell[TextData[{
