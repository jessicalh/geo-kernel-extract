       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Sin", "[", "t", "]"}], " ", 
          RowBox[{"Cos", "[", "az", "]"}]}], ",", 
         RowBox[{
          RowBox[{"Sin", "[", "t", "]"}], " ", 
          RowBox[{"Sin", "[", "az", "]"}]}], ",", 
         RowBox[{"Cos", "[", "t", "]"}]}], "}"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0.1", ",", 
        RowBox[{"Pi", "-", "0.1"}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Pi", "-", "0.2"}], ")"}], "/", "40"}]}], "}"}]}], "]"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fieldLinesL", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Darker", "@", "Blue"}], ",", "Thick", ",", 
       RowBox[{"dipoleLine", "[", 
        RowBox[{"r0", ",", "az"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"r0", ",", 
       RowBox[{"{", 
        RowBox[{"0.5", ",", "0.85", ",", "1.2"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"az", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"Pi", "/", "2"}], ",", "Pi", ",", 
         RowBox[{"3", " ", 
          RowBox[{"Pi", "/", "2"}]}]}], "}"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"panelMag", "=", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"dLobes", "[", "0.25", "]"}], ",", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{"{", 
       RowBox[{"fieldLinesL", ",", 
        RowBox[{"{", 
         RowBox[{"Black", ",", 
          RowBox[{"Arrowheads", "[", "0.05", "]"}], ",", 
          RowBox[{"Arrow", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "0", ",", "0.95"}], "}"}]}], "}"}], "]"}]}], 
         "}"}], ",", 
        RowBox[{"Text", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"\"\<m\>\"", ",", "Italic", ",", "12"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "1.08"}], "}"}]}], "]"}]}], "}"}], 
      "]"}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"PlotLabel", "->", 
      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<magnetic:  \>\"", ",", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<B\>\"", ",", "Bold"}], "]"}], 
           ",", "\"\< = (\[Mu]\:2080/4\[Pi]) D\[CenterDot]\>\"", ",", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<m\>\"", ",", "Bold"}], "]"}]}], "}"}], "]"}], ",", 
        "9"}], "]"}]}], ",", 
     RowBox[{"ViewPoint", "->", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1.3", ",", "0.8"}], "}"}]}], ",", 
     RowBox[{"ImageSize", "->", "300"}], ",", 
     RowBox[{"Boxed", "->", "False"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"radField", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Darker", "@", "Gray"}], ",", 
       RowBox[{"Arrowheads", "[", "0.03", "]"}], ",", 
       RowBox[{"Arrow", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"0.22", " ", 
           RowBox[{"Normalize", "[", "d", "]"}]}], ",", 
          RowBox[{"1.55", " ", 
           RowBox[{"Normalize", "[", "d", "]"}]}]}], "}"}], "]"}]}], "}"}], ",",
      "\[IndentingNewLine]", "   ", 
     RowBox[{"{", 
      RowBox[{"d", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "0", ",", "0.4"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "0", ",", "0.4"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1", ",", "0.4"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"-", "1"}], ",", "0.4"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0", ",", 
           RowBox[{"-", "0.4"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "0", ",", 
           RowBox[{"-", "0.4"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1", ",", 
           RowBox[{"-", "0.4"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"-", "1"}], ",", 
           RowBox[{"-", "0.4"}]}], "}"}]}], "}"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"panelEl", "=", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"dLobes", "[", "0.45", "]"}], ",", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"RGBColor", "[", 
           RowBox[{"0.78", ",", "0.2", ",", "0.2"}], "]"}], ",", 
          RowBox[{"PointSize", "[", "0.06", "]"}], ",", 
          RowBox[{"Point", "[", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "0"}], "}"}], "]"}]}], "}"}], ",", 
        "radField", ",", 
        RowBox[{"Text", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"\"\<q\>\"", ",", "Italic", ",", "12", ",", 
            RowBox[{"RGBColor", "[", 
             RowBox[{"0.78", ",", "0.2", ",", "0.2"}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"0.22", ",", "0", ",", "0.12"}], "}"}]}], "]"}]}], "}"}], 
      "]"}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"PlotLabel", "->", 
      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<electric:  \[PartialD]\>\"", ",", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<E\>\"", ",", "Bold"}], "]"}], 
           ",", "\"\< = \[Minus](q/4\[Pi]\[CurlyEpsilon]\:2080) D\>\""}], 
          "}"}], "]"}], ",", "9"}], "]"}]}], ",", 
     RowBox[{"ViewPoint", "->", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1.3", ",", "0.8"}], "}"}]}], ",", 
