 RowBox[{"GraphicsRow", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"panelMag", ",", "panelEl"}], "}"}], ",", 
   RowBox[{"Spacings", "->", "0"}], ",", 
