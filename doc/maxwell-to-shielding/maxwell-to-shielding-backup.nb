(* Beginning of Notebook Content *)
Notebook[{
Cell["Maxwell \[RightArrow] Shielding", "Title",ExpressionUUID->"bf4cf84f-dd43-fb43-a11f-b6f0d81a6987"],

Cell[TextData[{
 StyleBox["A step-by-step derivation: every classical calculator as one \
projection of a single kernel \[LongDash] and each step checked symbolically \
in Mathematica.",
  FontSlant->Italic],
 " The physics-architecture tower asserts a chain: Maxwell \[RightArrow] 1/\
\[Rho] \[RightArrow] ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["D", "TI"], 
        RowBox[{
          StyleBox["a", "TI"], 
          StyleBox["b", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "D_{ab}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9448c00d-8778-5742-8adc-59e0ff78d2a6"],
 " \[RightArrow] a fork into magnetic and electrical doorways \[RightArrow] \
the calculators \[RightArrow] shielding. This notebook turns each arrow of \
that tower into a derivation. The aim is to stop trusting the classical \
calculators as formulas and to show them as named projections of one kernel, \
the near-field shadow of Maxwell. Mathematica is the engine and the check: it \
does the symbolic algebra, and it confirms each step before the prose claims \
it. Every code cell below ends in a verification that comes back true \
\[LongDash] or a matrix of zeros \[LongDash] when the notebook is evaluated. \
"
}], "Text",ExpressionUUID->"ad5342a1-3b5c-934f-86f0-550e7b027611"],

Cell["How to read this notebook", "Section",ExpressionUUID->"7afc48b8-44f2-ff41-bb12-55af49818e73"],

Cell["\<\
Each rung is one section, and each section follows the same five beats: the \
starting point, the move that gets made, the result, what the result means, \
and which calculators the result grounds. The prose states a step; the code \
cell beneath it confirms that step in the kernel; the display equation \
carries the result. A reader can follow the prose alone, run the cells to \
watch each claim verified, or read the closed plumbing cells for the figure \
code. \
\>", "Text",ExpressionUUID->"7fc130e1-8eaf-7e4c-9595-7319ce71f5e4"],

Cell["Conventions \[LongDash] the one object, stripped to its geometry", \
"Section",ExpressionUUID->"8ea09ecb-c402-d047-9890-fb87eb3e36b5"],

Cell[TextData[{
 "The derivation is carried in the ",
 StyleBox["molecular frame",
  FontWeight->Bold],
 ", with the source at the origin and the field point at displacement ",
 StyleBox["\[Rho]",
  FontWeight->Bold],
 " of length \[Rho]. The geometry is shown ",
 StyleBox["unit-stripped",
  FontWeight->Bold],
 ": the prefactors \[Mu]\:2080/4\[Pi] (magnetic) and 1/4\[Pi]\[CurlyEpsilon]\
\:2080 (electric) are dropped while the kernel is built, then restored at \
each doorway in Rung 5, where they carry the SI units. This keeps the \
geometry \[LongDash] the only thing shared across every calculator \
\[LongDash] uncluttered by constants that differ between the magnetic and \
electric branches."
}], "Text",ExpressionUUID->"babf23bf-1293-7a49-ae61-cc149ac242d0"],

Cell[TextData[{
 "The one object is the second derivative of the Coulomb potential, written \
",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["D", "TI"], 
        RowBox[{
          StyleBox["a", "TI"], 
          StyleBox["b", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "D_{ab}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8cda29e0-46c7-1b4e-b20c-e6643741e7d4"],
 ": ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["D", "TI"], 
          RowBox[{
            StyleBox["a", "TI"], 
            StyleBox["b", "TI"]}]], " ", "\[LongEqual] ", 
         SubscriptBox["\[PartialD]", 
          StyleBox["a", "TI"]], 
         SubscriptBox["\[PartialD]", 
          StyleBox["b", "TI"]], 
         FractionBox["1", "\[Rho]"], " ", "\[LongEqual] ", 
         FractionBox[
          RowBox[{"3 ", 
            SubscriptBox[
             OverscriptBox["\[Rho]", "^"], 
             StyleBox["a", "TI"]], 
            SubscriptBox[
             OverscriptBox["\[Rho]", "^"], 
             StyleBox["b", "TI"]], "-", 
            SubscriptBox["\[Delta]", 
             RowBox[{
               StyleBox["a", "TI"], 
               StyleBox["b", "TI"]}]]}], 
          SuperscriptBox["\[Rho]", "3"]], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "D_{ab} \\;=\\; \\partial_a\\partial_b\\frac{1}{\\rho} \\;=\\; \
\\frac{3\\,\\hat\\rho_a\\hat\\rho_b - \\delta_{ab}}{\\rho^3}.", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6350f7dd-7b3e-9a45-8a06-e1904abf41a7"],
 "The setup cell defines the field point ",
 StyleBox["coords", "TI"],
 ", the distance ",
 StyleBox["rho", "TI"],
 ", the unit separation ",
 StyleBox["rhat", "TI"],
 ", and builds ",
 Cell[BoxData[Cell["Dab",
   Background->None,ExpressionUUID->"98b6ced7-3d94-e54b-b3f3-b226bba9cd3c"]], 
  "InlineCode",ExpressionUUID->"559f9ce9-e2df-994b-92ad-746ebe6d6bc9"],
 " once by direct differentiation. Every later cell reuses these. "
}], "Text",ExpressionUUID->"6e0b4b2b-494c-8142-a5b7-7d2a2e85f017"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"coords", "=", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], ";"}], "                  ", 
  
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"field", " ", "point"}], ";", " ", 
    RowBox[{
    "the", " ", "source", " ", "sits", " ", "at", " ", "the", " ", 
     "origin"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rho", "=", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{"x", "^", "2"}], "+", 
      RowBox[{"y", "^", "2"}], "+", 
      RowBox[{"z", "^", "2"}]}], "]"}]}], ";"}], "         ", 
  RowBox[{"(*", " ", 
   RowBox[{"separation", " ", "distance"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rhat", "=", 
    RowBox[{"coords", "/", "rho"}]}], ";"}], "                   ", 
  RowBox[{"(*", " ", 
   RowBox[{"unit", " ", "separation", " ", "vector"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Dab", "=", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"1", "/", "rho"}], ",", 
        RowBox[{"coords", "[", 
         RowBox[{"[", "a", "]"}], "]"}], ",", 
        RowBox[{"coords", "[", 
         RowBox[{"[", "b", "]"}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"b", ",", "3"}], "}"}]}], "]"}], " ", "//", " ", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"MatrixForm", "[", "Dab", "]"}]}], "Input",ExpressionUUID->"a92a2a68-\
3ceb-7948-ac43-ce652fbb772e"],

Cell["\<\
Rung 1 \[LongDash] Maxwell's source equations become Poisson equations for \
the potentials\
\>", "Section",ExpressionUUID->"815930b0-d3d1-6a4a-ba1b-0c6e2ddc4e6b"],

Cell[TextData[{
 "The two source equations of electromagnetism are Gauss's law and Amp\
\[EGrave]re's law. Gauss's law sets the divergence of the electric field by \
the charge density. Amp\[EGrave]re's law (static) sets the curl of the \
magnetic field by the current density. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Del]", "\[CenterDot]", 
         StyleBox["E", FontSlant -> "Bold"], "\[LongEqual]", 
         FractionBox[
          SubscriptBox["\[Rho]", "ch"], 
          SubscriptBox["\[Epsilon]", "0"]], ",    ", "\[Del]", "\[Cross]", 
         StyleBox["B", FontSlant -> "Bold"], "\[LongEqual]", 
         SubscriptBox["\[Mu]", "0"], " ", 
         StyleBox["J", FontSlant -> "Bold"], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\nabla\\cdot\\mathbf{E} = \
\\frac{\\rho_{\\text{ch}}}{\\varepsilon_0},\\qquad \\nabla\\times\\mathbf{B} \
= \\mu_0\\,\\mathbf{J}.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9181ae7e-6475-8c46-a613-b0dc30437685"],
 "Each field is rewritten through a potential. The electric field is minus \
the gradient of a scalar potential, which is exact because the static field \
is curl-free. The magnetic field is the curl of a vector potential, which is \
exact because the field is divergence-free. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["E", FontSlant -> "Bold"], "\[LongEqual]", "-", "\[Del]", 
         "\[CurlyPhi]", ",    ", 
         StyleBox["B", FontSlant -> "Bold"], "\[LongEqual]", "\[Del]", 
         "\[Cross]", 
         StyleBox["A", FontSlant -> "Bold"], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mathbf{E} = -\\nabla\\varphi,\\qquad \\mathbf{B} = \
\\nabla\\times\\mathbf{A}.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "87228159-fea1-2c42-9e61-018af9346ffc"],
 "Substituting the scalar potential into Gauss's law turns it into a Poisson \
equation for \[CurlyPhi]. Substituting the vector potential into \
Amp\[EGrave]re's law, and using the vector identity for the curl of a curl, \
turns it into a Poisson equation for each component of ",
 StyleBox["A",
  FontWeight->Bold],
 " once the Coulomb gauge \[Del]\[CenterDot]",
 StyleBox["A",
  FontWeight->Bold],
 " = 0 is imposed. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Del]", "2"], "\[CurlyPhi]", "\[LongEqual]", "-", 
         FractionBox[
          SubscriptBox["\[Rho]", "ch"], 
          SubscriptBox["\[Epsilon]", "0"]], ",    ", 
         SuperscriptBox["\[Del]", "2"], 
         StyleBox["A", FontSlant -> "Bold"], "\[LongEqual]", "-", 
         SubscriptBox["\[Mu]", "0"], " ", 
         StyleBox["J", FontSlant -> "Bold"], "  ", 
         RowBox[{"(", 
           RowBox[{"\[Del]", "\[CenterDot]", 
             StyleBox["A", FontSlant -> "Bold"], "\[LongEqual]", "0"}], ")"}],
          "."}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\nabla^2\\varphi = -\\frac{\\rho_{\\text{ch}}}{\\varepsilon_0},\\qquad \
\\nabla^2\\mathbf{A} = \
-\\mu_0\\,\\mathbf{J}\\quad(\\nabla\\cdot\\mathbf{A}=0).", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "664c10c8-c67c-8d4e-9352-81012406f69f"],
 "The cell verifies the two substitutions on generic fields. The electric \
check confirms that the divergence of \[Minus]\[Del]\[CurlyPhi] is \[Minus]\
\[Del]\.b2\[CurlyPhi]. The magnetic check confirms the curl-of-curl identity \
\[Del]\[Times](\[Del]\[Times]",
 StyleBox["A",
  FontWeight->Bold],
 ") = \[Del](\[Del]\[CenterDot]",
 StyleBox["A",
  FontWeight->Bold],
 ") \[Minus] \[Del]\.b2",
 StyleBox["A",
  FontWeight->Bold],
 ", after which the gauge condition removes the first term. "
}], "Text",ExpressionUUID->"35fe1609-1a09-7545-b936-48c8a9d6c397"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"electric", ":", " ", "E"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"-", "grad"}], " ", "phi"}]}], ",", " ", 
    RowBox[{
     RowBox[{"so", " ", "Gauss", " ", "div", " ", "E"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"rho", "/", "eps0"}], " ", "becomes", " ", "Poisson"}]}]}], " ",
    "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"phi", "=", 
     RowBox[{"pot", "[", 
      RowBox[{"x", ",", "y", ",", "z"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Efield", "=", 
     RowBox[{"-", 
      RowBox[{"Grad", "[", 
       RowBox[{"phi", ",", "coords"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"electricCheck", "=", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"Div", "[", 
         RowBox[{"Efield", ",", "coords"}], "]"}], "+", 
        RowBox[{"Laplacian", "[", 
         RowBox[{"phi", ",", "coords"}], "]"}]}], "]"}], "===", "0"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"magnetic", ":", " ", "B"}], " ", "=", " ", 
      RowBox[{"curl", " ", "A"}]}], ",", " ", 
     RowBox[{
      RowBox[{"and", " ", "curl", " ", "curl", " ", "A"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"grad", 
        RowBox[{"(", 
         RowBox[{"div", " ", "A"}], ")"}]}], " ", "-", " ", 
       RowBox[{"Laplacian", " ", "A"}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Avec", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ax", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
       RowBox[{"ay", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
       RowBox[{"az", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"magneticCheck", "=", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"Curl", "[", 
         RowBox[{
          RowBox[{"Curl", "[", 
           RowBox[{"Avec", ",", "coords"}], "]"}], ",", "coords"}], "]"}], 
        "\[IndentingNewLine]", "     ", "-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Grad", "[", 
           RowBox[{
            RowBox[{"Div", "[", 
             RowBox[{"Avec", ",", "coords"}], "]"}], ",", "coords"}], "]"}], "-", 
          RowBox[{"Laplacian", "[", 
           RowBox[{"Avec", ",", "coords"}], "]"}]}], ")"}]}], "]"}], "===", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<div(-grad phi) == -Laplacian phi\>\"", "->", 
      "electricCheck"}], ",", "\[IndentingNewLine]", " ", 
     RowBox[{"\"\<curl curl A == grad(div A) - Laplacian A\>\"", "->", 
      "magneticCheck"}]}], "}"}]}]}]], "Input",ExpressionUUID->"0b5ce29e-85b7-\
5d44-937e-62ab22638878"],

Cell[TextData[{
 "The meaning is that both potentials obey the same operator, the Laplacian, \
against their own source. The electric and magnetic problems are now one \
mathematical problem solved twice. This is the step that makes a single \
Green's function serve both branches (Jackson, ",
 StyleBox["Classical Electrodynamics",
  FontSlant->Italic],
 ", \[Section]6.3). ",
 StyleBox["\[RightArrow] grounds: nothing yet computes here; this rung sets \
up the shared operator that the rest of the chain solves.",
  FontSlant->Italic]
}], "Text",ExpressionUUID->"d50c9fbe-240b-1f47-abc3-c26da986551a"],

Cell["Rung 2 \[LongDash] The Coulomb Green's function 1/\[Rho] \[LongDash] \
the waist", "Section",ExpressionUUID->"b12355d8-2b08-eb48-a9c0-d6471819c64f"],

Cell[TextData[{
 "The Poisson operator is inverted by its Green's function, the field of a \
unit point source. The Green's function satisfies the Laplacian against a \
point source of strength \[Minus]4\[Pi], and its solution is 1/\[Rho]. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Del]", "2"], 
         StyleBox["G", "TI"], "\[LongEqual]", "-4", "\[Pi] ", 
         SuperscriptBox["\[Delta]", "3"], 
         RowBox[{"(", "\[Rho]", ")"}], ",    ", 
         StyleBox["G", "TI"], 
         RowBox[{"(", "\[Rho]", ")"}], "\[LongEqual]", 
         FractionBox["1", "\[Rho]"], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\nabla^2 G = -4\\pi\\,\\delta^3(\\boldsymbol{\\rho}),\\qquad \
G(\\boldsymbol{\\rho}) = \\frac{1}{\\rho}.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cfcb086c-1230-9f4a-9088-1c48087b96d9"],
 "The cell confirms 1/\[Rho] is a solution in two parts. Away from the origin \
the Laplacian of 1/\[Rho] is zero, so 1/\[Rho] is harmonic everywhere the \
source is not. The source itself is recovered as a flux: the surface integral \
of \[Del](1/\[Rho]) over any sphere centred on the origin is \[Minus]4\[Pi], \
independent of the radius, which is the integrated form of the delta source. \
"
}], "Text",ExpressionUUID->"61910b2a-9fa5-7d4e-b533-eeea653c3802"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"laplaceCheck", "=", 
    RowBox[{"Simplify", "[", 
     RowBox[{"Laplacian", "[", 
      RowBox[{
       RowBox[{"1", "/", "rho"}], ",", "coords"}], "]"}], "]"}]}], ";"}], 
  "        ", 
  RowBox[{"(*", " ", 
   RowBox[{"0", " ", "away", " ", "from", " ", "the", " ", "origin"}], " ", 
   "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"flux", " ", "of", " ", "grad", 
    RowBox[{"(", 
     RowBox[{"1", "/", "rho"}], ")"}], " ", "through", " ", "a", " ", 
    "sphere", " ", "of", " ", "radius", " ", 
    RowBox[{"R", " ", "--"}], " ", "the", " ", "delta", " ", "source"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gradG", "=", 
   RowBox[{"Grad", "[", 
    RowBox[{
     RowBox[{"1", "/", "rho"}], ",", "coords"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"onSphere", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"R", " ", 
      RowBox[{"Sin", "[", "th", "]"}], " ", 
      RowBox[{"Cos", "[", "ph", "]"}]}], ",", 
     RowBox[{"R", " ", 
      RowBox[{"Sin", "[", "th", "]"}], " ", 
      RowBox[{"Sin", "[", "ph", "]"}]}], ",", 
     RowBox[{"R", " ", 
      RowBox[{"Cos", "[", "th", "]"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"flux", "=", 
    RowBox[{"Integrate", "[", "\[IndentingNewLine]", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"gradG", " ", ".", " ", 
           RowBox[{"(", 
            RowBox[{"coords", "/", "rho"}], ")"}]}], " ", "/.", " ", 
          RowBox[{"Thread", "[", 
           RowBox[{"coords", "->", "onSphere"}], "]"}]}], ")"}], " ", 
        RowBox[{"R", "^", "2"}], " ", 
        RowBox[{"Sin", "[", "th", "]"}]}], " ", "//", " ", "Simplify"}], ",", 
      "\[IndentingNewLine]", "    ", 
      RowBox[{"{", 
       RowBox[{"th", ",", "0", ",", "Pi"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"ph", ",", "0", ",", 
        RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{"R", ">", "0"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<Laplacian[1/rho] off origin\>\"", "->", "laplaceCheck"}], ",", 
   RowBox[{"\"\<sphere flux of grad(1/rho)\>\"", "->", "flux"}]}], 
  "}"}]}], "Input",ExpressionUUID->"495210a6-fd96-8748-a23c-01d5da00a065"],

Cell[TextData[{
 "This is the waist of the whole chain. Both the scalar potential \[CurlyPhi] \
and the vector potential ",
 StyleBox["A",
  FontWeight->Bold],
 " are built by convolving their source against this one function 1/\[Rho]. \
The electric potential is 1/\[Rho] smeared over charge; the magnetic vector \
potential is 1/\[Rho] smeared over current. The place where the electric and \
the magnetic become one geometry is here, in the single function they share \
(Jackson \[Section]1.7). ",
 StyleBox["\[RightArrow] grounds: the Coulomb calculator is 1/\[Rho] itself, \
undifferentiated; every other calculator is a derivative of this object.",
  FontSlant->Italic]
}], "Text",ExpressionUUID->"fd5895d8-56fa-504f-9d77-af37bff68969"],

Cell["Rung 3 \[LongDash] The second derivative: the kernel D", "Section",ExpressionUUID->"da9fd0a0-c270-ae46-beb3-f6ad66ba1dbb"],

Cell[TextData[{
 "A localized source is read at a distance through the derivatives of \
1/\[Rho]. The first derivative is the field: the gradient of 1/\[Rho] is the \
Coulomb field direction, falling as 1/\[Rho]\.b2. The second derivative is \
the field's spatial variation: the Hessian of 1/\[Rho] is the tensor the \
thesis calls ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["D", "TI"], 
        RowBox[{
          StyleBox["a", "TI"], 
          StyleBox["b", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "D_{ab}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "755be7a1-551a-d348-aae1-45de5f21638f"],
 ". ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[PartialD]", 
          StyleBox["a", "TI"]], 
         FractionBox["1", "\[Rho]"], "\[LongEqual]", "-", 
         FractionBox[
          SubscriptBox[
           OverscriptBox["\[Rho]", "^"], 
           StyleBox["a", "TI"]], 
          SuperscriptBox["\[Rho]", "2"]], ",    ", 
         SubscriptBox[
          StyleBox["D", "TI"], 
          RowBox[{
            StyleBox["a", "TI"], 
            StyleBox["b", "TI"]}]], "\[LongEqual]", 
         SubscriptBox["\[PartialD]", 
          StyleBox["a", "TI"]], 
         SubscriptBox["\[PartialD]", 
          StyleBox["b", "TI"]], 
         FractionBox["1", "\[Rho]"], "\[LongEqual]", 
         FractionBox[
          RowBox[{"3 ", 
            SubscriptBox[
             OverscriptBox["\[Rho]", "^"], 
             StyleBox["a", "TI"]], 
            SubscriptBox[
             OverscriptBox["\[Rho]", "^"], 
             StyleBox["b", "TI"]], "-", 
            SubscriptBox["\[Delta]", 
             RowBox[{
               StyleBox["a", "TI"], 
               StyleBox["b", "TI"]}]]}], 
          SuperscriptBox["\[Rho]", "3"]], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\partial_a\\frac{1}{\\rho} = -\\frac{\\hat\\rho_a}{\\rho^2},\\qquad \
D_{ab} = \\partial_a\\partial_b\\frac{1}{\\rho} = \
\\frac{3\\,\\hat\\rho_a\\hat\\rho_b-\\delta_{ab}}{\\rho^3}.", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "035646d3-7986-ae41-a1ef-5ac1f938f231"],
 "The cell verifies both derivatives against their closed forms. The \
first-derivative check confirms the field is \[Minus]\[Rho]\:0302/\[Rho]\.b2. \
The second-derivative check subtracts the claimed closed form (3\[Rho]\:0302\
\[Rho]\:0302 \[Minus] \[Delta])/\[Rho]\.b3 from the directly differentiated \
Hessian and returns the zero matrix. "
}], "Text",ExpressionUUID->"5319e15f-83c3-a04d-ad93-8e6e4a1b8080"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"field", "=", 
    RowBox[{
     RowBox[{"Grad", "[", 
      RowBox[{
       RowBox[{"1", "/", "rho"}], ",", "coords"}], "]"}], " ", "//", " ", 
     "Simplify"}]}], ";"}], "                              ", 
  RowBox[{"(*", " ", 
   RowBox[{"first", " ", 
    RowBox[{"derivative", ":", " ", 
     RowBox[{"the", " ", "field"}]}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"claimed", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"3", " ", 
         RowBox[{"rhat", "[", 
          RowBox[{"[", "a", "]"}], "]"}], " ", 
         RowBox[{"rhat", "[", 
          RowBox[{"[", "b", "]"}], "]"}]}], "-", 
        RowBox[{"KroneckerDelta", "[", 
         RowBox[{"a", ",", "b"}], "]"}]}], ")"}], "/", 
      RowBox[{"rho", "^", "3"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"b", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"identityCheck", "=", 
    RowBox[{"Simplify", "[", 
     RowBox[{"Dab", "-", "claimed"}], "]"}]}], ";"}], 
  "                              ", 
  RowBox[{"(*", " ", 
   RowBox[{"the", " ", "zero", " ", "matrix"}], " ", "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<grad(1/rho) == -rhat/rho^2\>\"", "->", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"field", "+", 
        RowBox[{"rhat", "/", 
         RowBox[{"rho", "^", "2"}]}]}], "]"}], "===", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ")"}]}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"\"\<Dab - (3 rhat rhat - delta)/rho^3\>\"", "->", 
    RowBox[{"MatrixForm", "[", "identityCheck", "]"}]}]}], "}"}]}], "Input",Ex\
pressionUUID->"0db4278e-cdff-d545-a941-4044d78b8a39"],

Cell[TextData[{
 "The meaning is that one tensor object now stands behind every through-space \
measure. The Hessian of the Coulomb potential is the same object as the \
dipolar coupling tensor and the electric field gradient. Whatever the source \
\[LongDash] an induced moment or a charge \[LongDash] its through-space \
signature at a nucleus is read through this single tensor. *\[RightArrow] \
grounds: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["D", "TI"], 
        RowBox[{
          StyleBox["a", "TI"], 
          StyleBox["b", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "D_{ab}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b73fae2c-b471-cc48-82cd-2cceeaa77f29"],
 " is the object the magnetic and electric calculators each contract; the \
next rung reads its geometry, and Rung 5 sends it through the two doorways.* \
"
}], "Text",ExpressionUUID->"d8bfd184-ad6f-fe45-b3b0-bc81efcedf59"],

Cell["Rung 4 \[LongDash] The geometry of D", "Section",ExpressionUUID->"06d5f7d4-bc3e-2a4b-b0b4-e9a7b2a6ecf5"],

Cell[TextData[{
 "The kernel is a real symmetric 3\[Times]3 tensor, so it is fixed by its \
trace, its eigenvalues, and its eigenvectors. The trace is zero, so the \
tensor has no isotropic part and is pure anisotropy \[LongDash] the part NMR \
through-space effects are made of. Its eigenvalues are +2/\[Rho]\.b3 along \
the separation and \[Minus]1/\[Rho]\.b3 in the two directions across it. \
Contracting the tensor onto a fixed axis gives the angular law (3cos\.b2\
\[Theta] \[Minus] 1)/\[Rho]\.b3, which vanishes at the magic angle. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{
           StyleBox["T", "TI"], 
           StyleBox["r", "TI"]}], 
         StyleBox["D", "TI"], "\[LongEqual]", "0", ",    ", 
         StyleBox["D", "TI"], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["D", "TI"], 
          StyleBox["T", FontSlant -> "Plain"]], ",    ", 
         RowBox[{
           StyleBox["e", "TI"], 
           StyleBox["i", "TI"], 
           StyleBox["g", "TI"]}], 
         RowBox[{"(", 
           StyleBox["D", "TI"], ")"}], "\[LongEqual]", 
         RowBox[{"{", 
           RowBox[{
             FractionBox["+2", 
              SuperscriptBox["\[Rho]", "3"]], ", ", 
             FractionBox["-1", 
              SuperscriptBox["\[Rho]", "3"]], ", ", 
             FractionBox["-1", 
              SuperscriptBox["\[Rho]", "3"]]}], "}"}], "."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\operatorname{Tr} D = 0, \\qquad D = D^{\\mathsf{T}}, \\qquad \
\\operatorname{eig}(D) = \\left\\{ \\frac{+2}{\\rho^3},\\ \
\\frac{-1}{\\rho^3},\\ \\frac{-1}{\\rho^3} \\right\\}.", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "39823c6d-8dd7-7f48-8d26-45640da6d621"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["n", "TI"], "^"], "\[CenterDot]", 
         StyleBox["D", "TI"], "\[CenterDot]", 
         OverscriptBox[
          StyleBox["n", "TI"], "^"], "\[LongEqual]", 
         FractionBox[
          RowBox[{"3", 
            SuperscriptBox["cos", "2"], "\[Theta]", "-", "1"}], 
          SuperscriptBox["\[Rho]", "3"]], ",    ", 
         SubscriptBox["\[Theta]", "magic"], "\[LongEqual]", "arccos", 
         FractionBox["1", 
          SqrtBox["3"]], "\[LongEqual]", 
         SuperscriptBox["54.74", "\[EmptySmallCircle]"], "."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\hat n\\cdot D\\cdot\\hat n = \\frac{3\\cos^2\\theta - \
1}{\\rho^3},\\qquad \\theta_{\\text{magic}} = \\arccos\\frac{1}{\\sqrt 3} = \
54.74^\\circ.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a88a0fa3-aad1-2c45-9662-84ca9e285b9e"],
 "The cell reads each property off ",
 Cell[BoxData[Cell["Dab",
   Background->None,ExpressionUUID->"f5140a8e-c02e-c74c-9095-340a3ce09ba5"]], 
  "InlineCode",ExpressionUUID->"efdd1685-08e0-154f-8e5c-f30a070910a1"],
 " directly. It confirms the tensor equals its transpose and that its trace \
simplifies to zero. It returns the eigenvalues, which are the two \[Minus]1/\
\[Rho]\.b3 values and the single +2/\[Rho]\.b3 value. It contracts ",
 Cell[BoxData[Cell["Dab",
   Background->None,ExpressionUUID->"e93a951a-77fe-d840-b5f1-7aa471bc8098"]], 
  "InlineCode",ExpressionUUID->"74045be3-dee8-b642-85f0-7fe2ebd745e5"],
 " onto the z-axis, substitutes the polar angle, and confirms the contraction \
equals (3cos\.b2\[Theta] \[Minus] 1)/\[Rho]\.b3, whose root is the magic \
angle. "
}], "Text",ExpressionUUID->"47356e1e-dc29-7048-a947-4b1271ebf32f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"symmetric", "=", 
   RowBox[{"Dab", "===", 
    RowBox[{"Transpose", "[", "Dab", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"traceless", "=", 
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{"Tr", "[", "Dab", "]"}], "]"}], "===", "0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"evals", ",", "evecs"}], "}"}], "=", 
    RowBox[{"Eigensystem", "[", "Dab", "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"angular", " ", 
     RowBox[{"law", ":", " ", 
      RowBox[{
      "contract", " ", "with", " ", "a", " ", "fixed", " ", "axis", " ", 
       "along", " ", "z"}]}]}], ";", " ", 
    RowBox[{"th", " ", "=", " ", 
     RowBox[{"angle", " ", "from", " ", "that", " ", "axis"}]}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nAxis", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"angular", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"nAxis", " ", ".", " ", "Dab", " ", ".", " ", "nAxis"}], " ", "/.",
      " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "->", 
        RowBox[{"r", " ", 
         RowBox[{"Sin", "[", "th", "]"}]}]}], ",", 
       RowBox[{"y", "->", "0"}], ",", 
       RowBox[{"z", "->", 
        RowBox[{"r", " ", 
         RowBox[{"Cos", "[", "th", "]"}]}]}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"magicCheck", "=", 
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"angular", "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"3", " ", 
           RowBox[{
            RowBox[{"Cos", "[", "th", "]"}], "^", "2"}]}], "-", "1"}], ")"}], 
        "/", 
        RowBox[{"r", "^", "3"}]}]}], ",", 
      RowBox[{"r", ">", "0"}]}], "]"}], "===", "0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"theta0", "=", 
    RowBox[{"ArcCos", "[", 
     RowBox[{"1", "/", 
      RowBox[{"Sqrt", "[", "3", "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<symmetric\>\"", "->", "symmetric"}], ",", 
   RowBox[{"\"\<traceless\>\"", "->", "traceless"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"\"\<eigenvalues\>\"", "->", 
    RowBox[{"Simplify", "[", "evals", "]"}]}], ",", "\[IndentingNewLine]", 
   " ", 
   RowBox[{"\"\<n.D.n == (3 cos^2 th - 1)/r^3\>\"", "->", "magicCheck"}], ",",
    "\[IndentingNewLine]", " ", 
   RowBox[{"\"\<magic angle (deg)\>\"", "->", 
    RowBox[{"N", "[", 
     RowBox[{"theta0", "/", "Degree"}], "]"}]}]}], "}"}]}], "Input",Expression\
UUID->"2af5631c-a724-424c-8951-f60e74d81798"],

Cell["\<\
The figure draws the shape these numbers describe. The radial part falls as \
1/\[Rho]\.b3, steep and near-field. The angular part is the double-lobed \
function 3cos\.b2\[Theta] \[Minus] 1: positive along the axis, where the \
eigenvalue is +2/\[Rho]\.b3, and negative in the equatorial band, where the \
eigenvalue is \[Minus]1/\[Rho]\.b3. The two signs meet at the cone \[Theta] = \
54.74\[Degree], where the kernel passes through zero. The plot shows the \
axial lobes in blue, the equatorial torus in red, and the magic-angle cone as \
the dashed ruling between them. \
\>", "Text",ExpressionUUID->"fb04aef2-d541-da4e-ad9a-d93d457f395f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"magicAngle", "=", 
   RowBox[{"ArcCos", "[", 
    RowBox[{"1", "/", 
     RowBox[{"Sqrt", "[", "3", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lobes", "=", 
   RowBox[{"SphericalPlot3D", "[", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"3", " ", 
        RowBox[{
         RowBox[{"Cos", "[", "t", "]"}], "^", "2"}]}], "-", "1"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "Pi"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"pp", ",", "0", ",", 
       RowBox[{"2", " ", "Pi"}]}], "}"}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"ColorFunction", "->", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"xx", ",", "yy", ",", "zz", ",", "t", ",", "pp"}], "}"}], ",",
         "\[IndentingNewLine]", "     ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"3", " ", 
             RowBox[{
              RowBox[{"Cos", "[", "t", "]"}], "^", "2"}]}], "-", "1"}], ">=", 
           "0"}], ",", 
          RowBox[{"RGBColor", "[", 
           RowBox[{"0.20", ",", "0.36", ",", "0.62"}], "]"}], ",", 
          RowBox[{"RGBColor", "[", 
           RowBox[{"0.78", ",", "0.36", ",", "0.36"}], "]"}]}], "]"}]}], 
       "]"}]}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"ColorFunctionScaling", "->", "False"}], ",", 
     RowBox[{"Mesh", "->", "None"}], ",", 
     RowBox[{"PlotPoints", "->", "45"}], ",", 
     RowBox[{"Boxed", "->", "False"}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"Axes", "->", "False"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"ImageSize", "->", "380"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nodeRing", "[", "sgn_", "]"}], ":=", 
   RowBox[{"Line", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Sin", "[", "magicAngle", "]"}], " ", 
         RowBox[{"Cos", "[", "pp", "]"}]}], ",", 
        RowBox[{
         RowBox[{"Sin", "[", "magicAngle", "]"}], " ", 
         RowBox[{"Sin", "[", "pp", "]"}]}], ",", 
        RowBox[{"sgn", " ", 
         RowBox[{"Cos", "[", "magicAngle", "]"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"pp", ",", "0", ",", 
        RowBox[{"2", " ", "Pi"}], ",", 
        RowBox[{"2", " ", 
         RowBox[{"Pi", "/", "60"}]}]}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ruling", "[", "sgn_", "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Line", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"1.6", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Sin", "[", "magicAngle", "]"}], " ", 
            RowBox[{"Cos", "[", "pp", "]"}]}], ",", 
           RowBox[{
            RowBox[{"Sin", "[", "magicAngle", "]"}], " ", 
            RowBox[{"Sin", "[", "pp", "]"}]}], ",", 
           RowBox[{"sgn", " ", 
            RowBox[{"Cos", "[", "magicAngle", "]"}]}]}], "}"}]}]}], "}"}], 
      "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"pp", ",", "0", ",", 
       RowBox[{
        RowBox[{"2", " ", "Pi"}], "-", "0.01"}], ",", 
       RowBox[{"2", " ", 
        RowBox[{"Pi", "/", "12"}]}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coneArt", "=", 
   RowBox[{"{", 
    RowBox[{"Gray", ",", 
     RowBox[{"Opacity", "[", "0.5", "]"}], ",", 
     RowBox[{"Dashing", "[", 
      RowBox[{"{", 
       RowBox[{"0.01", ",", "0.012"}], "}"}], "]"}], ",", 
     RowBox[{"ruling", "[", "1", "]"}], ",", 
     RowBox[{"ruling", "[", 
      RowBox[{"-", "1"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"Thick", ",", 
       RowBox[{"nodeRing", "[", "1", "]"}], ",", 
       RowBox[{"nodeRing", "[", 
        RowBox[{"-", "1"}], "]"}]}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Quiet", "@", 
  RowBox[{"Show", "[", 
   RowBox[{"lobes", ",", 
    RowBox[{"Graphics3D", "[", "coneArt", "]"}], ",", "\[IndentingNewLine]", 
    "  ", 
    RowBox[{"PlotLabel", "->", 
     RowBox[{"Style", "[", 
      RowBox[{"\"\<the shape of D_ab (node at 54.74 deg)\>\"", ",", "12"}], 
      "]"}]}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"ViewPoint", "->", 
     RowBox[{"{", 
      RowBox[{"2.0", ",", "1.4", ",", "0.9"}], "}"}]}], ",", 
    RowBox[{"PlotRange", "->", "All"}]}], "]"}]}]}], "Input",ExpressionUUID->\
"60efcc40-2802-f746-8df3-de0c14f9c773"],

Cell[TextData[{
 "The meaning is that the entire angular content of every through-space NMR \
effect is this one function. Whatever wears it \[LongDash] the McConnell \
scalar, the dipolar coupling, the electric field gradient \[LongDash] carries \
the same lobes and the same node. The thesis never collapses this rank-2 \
shape to a number; the next rungs keep it intact. ",
 StyleBox["\[RightArrow] grounds: the magic angle and the (3cos\.b2\[Theta] \
\[Minus] 1)/\[Rho]\.b3 law are the geometric content the angular calculators \
report; the radial 1/\[Rho]\.b3 is their distance dependence.",
  FontSlant->Italic]
}], "Text",ExpressionUUID->"c9f10c2a-14cb-9d4c-a7ac-0bd3996c05c6"],

Cell["Rung 5 \[LongDash] The fork: two doorways, one kernel", "Section",ExpressionUUID->"d950f4aa-5417-cf43-9686-4e689e1b929c"],

Cell[TextData[{
 "The kernel reaches the nucleus by two routes. A magnetic source contracts \
",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["D", "TI"], 
        RowBox[{
          StyleBox["a", "TI"], 
          StyleBox["b", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "D_{ab}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "32c92f01-8424-4b49-815a-5969650950d4"],
 " with an induced moment; an electric source contracts the same ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["D", "TI"], 
        RowBox[{
          StyleBox["a", "TI"], 
          StyleBox["b", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "D_{ab}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "98dd2b3c-bcd0-d740-af01-7759b14515d3"],
 " with a charge. The two branches differ only in what is contracted and in \
the SI prefactor restored at the door. The tensor between them is identical. \
"
}], "Text",ExpressionUUID->"0db7a98c-dad6-794f-aef3-0108c57bb62f"],

Cell["Magnetic doorway \[LongDash] D contracted with an induced moment", \
"Subsection",ExpressionUUID->"10f0c8d5-7634-7341-a3c2-e1e751f87c29"],

Cell[TextData[{
 "A point magnetic moment ",
 StyleBox["m",
  FontWeight->Bold],
 " sets up a vector potential proportional to ",
 StyleBox["m",
  FontWeight->Bold],
 " \[Times] \[Rho]\:0302 / \[Rho]\.b2. Its magnetic field is the curl of that \
vector potential. Away from the origin, that curl is exactly the kernel \
contracted with the moment, with the SI factor \[Mu]\:2080/4\[Pi] restored. \
",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["A", FontSlant -> "Bold"], "dip"], "\[LongEqual]", 
         FractionBox[
          SubscriptBox["\[Mu]", "0"], 
          RowBox[{"4", "\[Pi]"}]], " ", 
         FractionBox[
          RowBox[{
            StyleBox["m", FontSlant -> "Bold"], "\[Cross]", 
            OverscriptBox["\[Rho]", "^"]}], 
          SuperscriptBox["\[Rho]", "2"]], ",    ", 
         SubscriptBox[
          StyleBox["B", "TI"], 
          StyleBox["a", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          RowBox[{"(", 
            RowBox[{"\[Del]", "\[Cross]", 
              StyleBox["A", FontSlant -> "Bold"]}], ")"}], 
          StyleBox["a", "TI"]], "\[LongEqual]", 
         FractionBox[
          SubscriptBox["\[Mu]", "0"], 
          RowBox[{"4", "\[Pi]"}]], " ", 
         SubscriptBox[
          StyleBox["D", "TI"], 
          RowBox[{
            StyleBox["a", "TI"], 
            StyleBox["b", "TI"]}]], " ", 
         SubscriptBox[
          StyleBox["m", "TI"], 
          StyleBox["b", "TI"]], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\mathbf{A}_{\\text{dip}} = \
\\frac{\\mu_0}{4\\pi}\\,\\frac{\\mathbf{m}\\times\\hat\\rho}{\\rho^2},\\qquad \
B_a = (\\nabla\\times\\mathbf{A})_a = \\frac{\\mu_0}{4\\pi}\\,D_{ab}\\,m_b.", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e2d344bd-348e-bf44-be91-aab1fe00465d"],
 "The cell builds the unit-stripped dipole vector potential from a constant \
moment ",
 StyleBox["m",
  FontWeight->Bold],
 ", takes its curl to get the field, and subtracts the kernel contracted with \
the moment. The difference is the zero vector, so the dipole field is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["D", "TI"], 
          RowBox[{
            StyleBox["a", "TI"], 
            StyleBox["b", "TI"]}]], " ", 
         SubscriptBox[
          StyleBox["m", "TI"], 
          StyleBox["b", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "D_{ab}\\,m_b", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "91dac5f6-3295-9c42-b317-c489297d181b"],
 ". "
}], "Text",ExpressionUUID->"7a881ddc-a400-6042-89e6-f160d67605cc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"m", "=", 
    RowBox[{"{", 
     RowBox[{"mx", ",", "my", ",", "mz"}], "}"}]}], ";"}], 
  "                                  ", 
  RowBox[{"(*", " ", 
   RowBox[{"induced", " ", "point", " ", "moment"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Adip", "=", 
    RowBox[{
     RowBox[{"Cross", "[", 
      RowBox[{"m", ",", "coords"}], "]"}], "/", 
     RowBox[{"rho", "^", "3"}]}]}], ";"}], "                      ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"dipole", " ", "vector", " ", "potential"}], ",", " ", 
    RowBox[{
     RowBox[{"mu0", "/", "4"}], "pi", " ", "dropped"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Bdip", "=", 
    RowBox[{
     RowBox[{"Curl", "[", 
      RowBox[{"Adip", ",", "coords"}], "]"}], " ", "//", " ", "Simplify"}]}], 
   ";"}], "              ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"B", " ", "=", " ", 
     RowBox[{"curl", " ", "A"}]}], ",", " ", 
    RowBox[{"away", " ", "from", " ", "the", " ", "origin"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"magneticFork", "=", 
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{"Bdip", "-", 
      RowBox[{"Dab", " ", ".", " ", "m"}]}], "]"}], "===", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "0"}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{"\"\<B = curl(A_dip) equals D.m\>\"", "->", "magneticFork"}], 
  "}"}]}], "Input",ExpressionUUID->"91f82df8-f049-bc4e-8bdb-31ae935995b1"],

Cell[TextData[{
 "The induced moment is where the ring current enters: an aromatic ring in a \
field acquires a moment proportional to its susceptibility, and that moment's \
field at a nearby proton is read through ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["D", "TI"], 
        RowBox[{
          StyleBox["a", "TI"], 
          StyleBox["b", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "D_{ab}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8e94bf79-2697-1640-9b9a-5dde50c29672"],
 ". This is the doorway for ",
 StyleBox["McConnell, Johnson\[Dash]Bovey, Haigh\[Dash]Mallion, the \
ring-susceptibility model, the Biot\[Dash]Savart integration, and bond \
anisotropy",
  FontWeight->Bold],
 " (Pople 1956; McConnell 1957). "
}], "Text",ExpressionUUID->"4690327b-63b1-0547-9d00-dfa898afff7b"],

Cell["Electric doorway \[LongDash] D contracted with a charge", "Subsection",ExpressionUUID->"0c9bc568-68ed-5042-ae50-ad3e8ae688fb"],

Cell[TextData[{
 "A point charge q sets up the Coulomb potential 1/\[Rho] scaled by the \
charge. Its field is minus the gradient of that potential. The gradient of \
the field \[LongDash] the electric field gradient \[LongDash] is the same \
kernel ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["D", "TI"], 
        RowBox[{
          StyleBox["a", "TI"], 
          StyleBox["b", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "D_{ab}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "26ec8e5a-1c63-4749-a9c9-40a615bc5288"],
 ", with the SI factor 1/4\[Pi]\[CurlyEpsilon]\:2080 restored and the charge \
in place of the moment. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CurlyPhi]", "\[LongEqual]", 
         FractionBox["1", 
          RowBox[{"4", 
            SubscriptBox["\[Pi]\[Epsilon]", "0"]}]], " ", 
         FractionBox[
          StyleBox["q", "TI"], "\[Rho]"], ",    ", 
         SubscriptBox["\[PartialD]", 
          StyleBox["a", "TI"]], 
         SubscriptBox[
          StyleBox["E", "TI"], 
          StyleBox["b", "TI"]], "\[LongEqual]", "-", 
         FractionBox[
          StyleBox["q", "TI"], 
          RowBox[{"4", 
            SubscriptBox["\[Pi]\[Epsilon]", "0"]}]], " ", 
         SubscriptBox[
          StyleBox["D", "TI"], 
          RowBox[{
            StyleBox["a", "TI"], 
            StyleBox["b", "TI"]}]], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\varphi = \\frac{1}{4\\pi\\varepsilon_0}\\,\\frac{q}{\\rho},\\qquad \
\\partial_a E_b = -\\frac{q}{4\\pi\\varepsilon_0}\\,D_{ab}.", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4b3cec41-3b85-0b46-8a90-24d3222ad2e3"],
 "The cell builds the unit-stripped charge potential, takes minus its \
gradient for the field, then differentiates the field once more to form the \
field-gradient tensor. Subtracting \[Minus]q times the kernel gives the zero \
matrix, so the field gradient is the same ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["D", "TI"], 
        RowBox[{
          StyleBox["a", "TI"], 
          StyleBox["b", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "D_{ab}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fc813b9a-903a-1f40-a32c-da43a1a820fd"],
 " the magnetic branch used. "
}], "Text",ExpressionUUID->"95f41c90-29f8-2045-b8b1-84354a86ee56"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"phiq", "=", 
    RowBox[{"q", "/", "rho"}]}], ";"}], 
  "                                       ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"point", "-", 
     RowBox[{"charge", " ", "potential"}]}], ",", " ", 
    RowBox[{
     RowBox[{"1", "/", "4"}], "pi", " ", "eps0", " ", "dropped"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Eq", "=", 
    RowBox[{"-", 
     RowBox[{"Grad", "[", 
      RowBox[{"phiq", ",", "coords"}], "]"}]}]}], ";"}], 
  "                           ", 
  RowBox[{"(*", " ", 
   RowBox[{"E", " ", "=", " ", 
    RowBox[{
     RowBox[{"-", "grad"}], " ", "phi"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gradE", "=", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"Eq", "[", 
          RowBox[{"[", "b", "]"}], "]"}], ",", 
         RowBox[{"coords", "[", 
          RowBox[{"[", "a", "]"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"a", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"b", ",", "3"}], "}"}]}], "]"}], " ", "//", " ", 
     "Simplify"}]}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{"field", " ", "gradient"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"electricFork", "=", 
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{"gradE", "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"-", "q"}], ")"}], " ", "Dab"}]}], "]"}], "===", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"0", ",", 
      RowBox[{"{", 
       RowBox[{"3", ",", "3"}], "}"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{"\"\<grad(E) equals -q D\>\"", "->", "electricFork"}], 
  "}"}]}], "Input",ExpressionUUID->"cf196e74-a026-d344-a465-dcd285097b9b"],

Cell[TextData[{
 "The charge and its field gradient are where the electrostatic calculators \
enter: a charged or polar site sets a field at the nucleus, and the gradient \
of that field is read through ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["D", "TI"], 
        RowBox[{
          StyleBox["a", "TI"], 
          StyleBox["b", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "D_{ab}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "db766d15-04a2-e44b-81cb-c657c42794ed"],
 ". This is the doorway for ",
 StyleBox["Coulomb, APBS, the MOPAC-derived measures, EEQ, WaterField, and \
the \[Pi]-quadrupole",
  FontWeight->Bold],
 " (Slichter, ",
 StyleBox["Principles of Magnetic Resonance",
  FontSlant->Italic],
 ")."
}], "Text",ExpressionUUID->"b7084a72-1b5a-3f46-9e64-422d14a1f31a"],

Cell[TextData[{
 "The fork is the central claim made concrete: the magnetic field of a moment \
and the field gradient of a charge are the same tensor, contracted with \
different sources. H-bond and dispersion measures ride the seam between the \
two doorways. ",
 StyleBox["\[RightArrow] grounds: the two branches of the calculator library, \
each a contraction of the one kernel.",
  FontSlant->Italic]
}], "Text",ExpressionUUID->"eb2a2894-c271-a947-bbe8-f668df24c9fb"],

Cell["Rung 6 \[LongDash] Back to shielding: the Ramsey sum", "Section",ExpressionUUID->"7873fe95-71dd-bf41-b57d-99d87b9e4728"],

Cell[TextData[{
 "Shielding is the field the electron currents make when the applied field \
stirs them up (Ramsey 1950). The through-space part of the shielding tensor \
at nucleus i is the sum, over nearby sources s, of each source's kernel \
weighted by its intensity. The magnetic mechanisms add a field at the \
nucleus; the electric mechanisms perturb the electronic response. Both enter \
as a contraction of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["D", "TI"], 
        RowBox[{
          StyleBox["a", "TI"], 
          StyleBox["b", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "D_{ab}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8903d49d-6ece-314d-95c2-c1263fcb8a0c"],
 ". ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Sigma]", 
          RowBox[{
            StyleBox["a", "TI"], 
            StyleBox["b", "TI"]}]], 
         RowBox[{"(", 
           StyleBox["i", "TI"], ")"}], " ", "\[TildeTilde] ", 
         UnderscriptBox["\[Sum]", 
          StyleBox["s", "TI"], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["I", "TI"], 
          StyleBox["s", "TI"]], " ", 
         SubscriptBox[
          StyleBox["D", "TI"], 
          RowBox[{
            StyleBox["a", "TI"], 
            StyleBox["b", "TI"]}]], 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["r", FontSlant -> "Bold"], 
            RowBox[{
              StyleBox["i", "TI"], 
              StyleBox["s", "TI"]}]], ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\sigma_{ab}(i) \\;\\approx\\; \\sum_s I_s\\,D_{ab}(\\mathbf{r}_{is}).",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e9f5e606-d0a3-0d4c-afd4-d9512789144d"],
 "The cell places two sources at different sites, each contributing its own \
kernel about the nucleus, and forms their weighted sum. The sum is still \
symmetric and still traceless, so the rank-2 anisotropic structure survives \
the summation: many sources add up to one tensor of the same shape, never to \
a scalar. The cell then contracts a single axial source onto its own axis and \
recovers the ring-current angular factor, the McConnell law (1 \[Minus] 3cos\
\.b2\[Theta])/\[Rho]\.b3, which is minus the contraction of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["D", "TI"], 
        RowBox[{
          StyleBox["a", "TI"], 
          StyleBox["b", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "D_{ab}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "23d85115-a200-f744-8132-64307575fec5"],
 " (McConnell 1957). "
}], "Text",ExpressionUUID->"82422b32-487e-d647-bd02-06b11c94984c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Dsource", "[", "r0_", "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"u", "=", 
        RowBox[{"coords", "-", "r0"}]}], ",", 
       RowBox[{"n", "=", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"coords", "-", "r0"}], ")"}], " ", ".", " ", 
          RowBox[{"(", 
           RowBox[{"coords", "-", "r0"}], ")"}]}], "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"3", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"u", "[", 
              RowBox[{"[", "a", "]"}], "]"}], "/", "n"}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"u", "[", 
              RowBox[{"[", "b", "]"}], "]"}], "/", "n"}], ")"}]}], "-", 
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"a", ",", "b"}], "]"}]}], ")"}], "/", 
        RowBox[{"n", "^", "3"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"a", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"b", ",", "3"}], "}"}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sigma", "=", 
    RowBox[{
     RowBox[{"Ione", " ", 
      RowBox[{"Dsource", "[", 
       RowBox[{"{", 
        RowBox[{"a0", ",", "0", ",", "0"}], "}"}], "]"}]}], "+", 
     RowBox[{"Itwo", " ", 
      RowBox[{"Dsource", "[", 
       RowBox[{"{", 
        RowBox[{"0", ",", "b0", ",", "0"}], "}"}], "]"}]}]}]}], ";"}], "   ", 
  
  RowBox[{"(*", " ", 
   RowBox[{"sum_s", " ", "I_s", " ", "D_ab", 
    RowBox[{"(", "r_is", ")"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sumSymmetric", "=", 
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{"sigma", "-", 
      RowBox[{"Transpose", "[", "sigma", "]"}]}], "]"}], "===", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"0", ",", 
      RowBox[{"{", 
       RowBox[{"3", ",", "3"}], "}"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sumTraceless", "=", 
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{"Tr", "[", "sigma", "]"}], "]"}], "===", "0"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"McConnell", " ", "ring"}], "-", 
    RowBox[{"current", " ", 
     RowBox[{"factor", ":", " ", 
      RowBox[{
      "the", " ", "axial", " ", "diagonal", " ", "of", " ", "D"}]}]}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mcc", "=", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1"}], "}"}], " ", ".", " ", 
        RowBox[{"Dsource", "[", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0"}], "}"}], "]"}], " ", ".", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], ")"}], 
      "\[IndentingNewLine]", "      ", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", "->", 
         RowBox[{"r", " ", 
          RowBox[{"Sin", "[", "th", "]"}]}]}], ",", 
        RowBox[{"y", "->", "0"}], ",", 
        RowBox[{"z", "->", 
         RowBox[{"r", " ", 
          RowBox[{"Cos", "[", "th", "]"}]}]}]}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<sum stays symmetric\>\"", "->", "sumSymmetric"}], ",", 
   RowBox[{"\"\<sum stays traceless\>\"", "->", "sumTraceless"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"\"\<McConnell factor n.D.n\>\"", "->", "mcc"}]}], "}"}]}], "Input",\
ExpressionUUID->"dea9e722-ac1e-3043-940b-0cbbbcce7c53"],

Cell[TextData[{
 "The loop closes here. Maxwell's source equations became Poisson equations; \
the Poisson operator was inverted by 1/\[Rho]; the second derivative of 1/\
\[Rho] was the kernel ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["D", "TI"], 
        RowBox[{
          StyleBox["a", "TI"], 
          StyleBox["b", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "D_{ab}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4c15d559-b689-4443-a4d5-47adff9e229d"],
 "; the kernel's geometry gave the magic angle and the (3cos\.b2\[Theta] \
\[Minus] 1)/\[Rho]\.b3 law; the kernel forked into a magnetic and an electric \
doorway; and the doorways sum back into the shielding tensor. Each calculator \
computes one term of the final sum. ",
 StyleBox["\[RightArrow] grounds: the whole library at once \[LongDash] the \
sum is the calculators added together, each term one source read through the \
one kernel.",
  FontSlant->Italic]
}], "Text",ExpressionUUID->"d38f397f-7ea4-6446-98ee-45bd26695027"],

Cell["The chain, closed", "Section",ExpressionUUID->"700aad1f-5d61-9b40-985c-ca108a67fe64"],

Cell[TextData[{
 "The tower is now a theorem rather than a slogan. Maxwell \[RightArrow] 1/\
\[Rho] \[RightArrow] ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["D", "TI"], 
        RowBox[{
          StyleBox["a", "TI"], 
          StyleBox["b", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "D_{ab}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fc76b72b-6657-dd4c-b16d-d9dab68b79b7"],
 " \[RightArrow] the fork \[RightArrow] the calculators \[RightArrow] \
shielding holds at every rung, and each rung is checked above in the kernel. \
The classical calculators are not formulas the thesis trusts; they are the \
only thing they could have been, named projections of one geometry that is \
the near-field shadow of Maxwell. "
}], "Text",ExpressionUUID->"c41aa7cd-57c7-5f42-b740-6ebc7aadf72f"],

Cell["References", "Section",ExpressionUUID->"840823b7-1234-e642-91a4-00fba8c0350f"],

Cell[TextData[{
 StyleBox["Jackson, J. D.",
  FontWeight->Bold],
 " (1999). ",
 StyleBox["Classical Electrodynamics",
  FontSlant->Italic],
 ", 3rd ed. Wiley. \[Section]1.7 (Green's function of the Laplacian), \
\[Section]5.6 (magnetic dipole field), \[Section]6.3 (potentials and gauge)."
}], "Item",ExpressionUUID->"48e3f6db-bbb8-4c40-b5a7-a1eb5bd49186"],

Cell[TextData[{
 StyleBox["McConnell, H. M.",
  FontWeight->Bold],
 " (1957). Theory of nuclear magnetic shielding in molecules. ",
 StyleBox["Journal of Chemical Physics",
  FontSlant->Italic],
 " ",
 StyleBox["27",
  FontWeight->Bold],
 ", 226\[Dash]229. The (1 \[Minus] 3cos\.b2\[Theta])/r\.b3 ring-current shift \
from a point anisotropic susceptibility."
}], "Item",ExpressionUUID->"3384d0b6-f940-234b-a865-562757394ad7"],

Cell[TextData[{
 StyleBox["Pople, J. A.",
  FontWeight->Bold],
 " (1956). Proton magnetic resonance of hydrocarbons. ",
 StyleBox["Journal of Chemical Physics",
  FontSlant->Italic],
 " ",
 StyleBox["24",
  FontWeight->Bold],
 ", 1111. The point-dipole model of the aromatic ring current."
}], "Item",ExpressionUUID->"996a0e39-afeb-8849-9af7-bb517cad0f95"],

Cell[TextData[{
 StyleBox["Ramsey, N. F.",
  FontWeight->Bold],
 " (1950). Magnetic shielding of nuclei in molecules. ",
 StyleBox["Physical Review",
  FontSlant->Italic],
 " ",
 StyleBox["78",
  FontWeight->Bold],
 ", 699\[Dash]703. The shielding tensor as the current response to the \
applied field."
}], "Item",ExpressionUUID->"f26d29f3-6a17-2a43-9d2c-5d935b341bb5"],

Cell[TextData[{
 StyleBox["Slichter, C. P.",
  FontWeight->Bold],
 " (1990). ",
 StyleBox["Principles of Magnetic Resonance",
  FontSlant->Italic],
 ", 3rd ed. Springer. The electric field gradient and the quadrupolar \
interaction."
}], "Item",ExpressionUUID->"dc3d9784-50c1-664b-a612-82caab735911"]
},
FrontEndVersion->"14.3 for Microsoft Windows (64-bit) (July 8, 2025)",
