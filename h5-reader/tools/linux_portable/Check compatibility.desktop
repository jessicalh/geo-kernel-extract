[Desktop Entry]
Type=Application
Version=1.0
Name=Check Reader compatibility
Comment=Check this Linux computer without opening or copying trajectories
Exec=/bin/sh -c "desktop=\\${1:-\\${GIO_LAUNCHED_DESKTOP_FILE:-}}; [ -n \\"\\$desktop\\" ] || { echo \\"This older gio CLI omits the desktop path. Open this launcher from the file manager, or run check-compatibility.sh.\\" >&2; exit 1; }; exec /bin/sh \\"\\$(dirname \\"\\$desktop\\")/check-compatibility.sh\\" --show-report" sh %k
Icon=applications-science
Terminal=false
Categories=Science;
StartupNotify=false
